{
    "name": "t3docs/examples",
    "description": "Core Documentation Code Examples - This extension packages a number of code examples from the Core Documentation.",
    "license": [
        "GPL-2.0+"
    ],
    "type": "typo3-cms-extension",
    "authors": [
        {
            "name": "Documentation Team",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "typo3/cms-backend": "15.0.x-dev || dev-main",
        "typo3/cms-core": "15.0.x-dev || dev-main",
        "typo3/cms-extbase": "15.0.x-dev || dev-main",
        "typo3/cms-fluid": "15.0.x-dev || dev-main",
        "typo3/cms-fluid-styled-content": "15.0.x-dev || dev-main",
        "typo3/cms-impexp": "15.0.x-dev || dev-main",
        "typo3/cms-install": "15.0.x-dev || dev-main",
        "typo3/cms-linkvalidator": "15.0.x-dev || dev-main",
        "typo3/cms-reactions": "15.0.x-dev || dev-main"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.57",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "typo3/coding-standards": "^0.9",
        "typo3/testing-framework": "^10.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "T3docs\\Examples\\": "Classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "15.0.x-dev"
        },
        "typo3/cms": {
            "Package": {
                "providesPackages": {}
            },
            "extension-key": "examples",
            "version": "15.0.0",
            "web-dir": ".Build/Web"
        }
    },
    "scripts": {
        "check": [
            "@check:composer",
            "@check:php"
        ],
        "check:composer": [
            "@check:composer:config"
        ],
        "check:composer:config": "Build/Scripts/runTests.sh -n -s composerNormalize",
        "check:php": [
            "@check:php:lint",
            "@check:php:cs"
        ],
        "check:php:cs": "Build/Scripts/runTests.sh -n -s cgl",
        "check:php:lint": "Build/Scripts/runTests.sh -s lint",
        "fix": [
            "@fix:composer",
            "@fix:php"
        ],
        "fix:composer": [
            "@fix:composer:config"
        ],
        "fix:composer:config": "Build/Scripts/runTests.sh -s composerNormalize",
        "fix:php": [
            "@fix:php:cs"
        ],
        "fix:php:cs": "Build/Scripts/runTests.sh -s cgl",
        "prepare-release": [
            "rm -rf .Build",
            "rm -rf .github",
            "rm .gitattributes",
            "rm .gitignore",
            "rm .editorconfig",
            "rm .php-cs-fixer.dist.php",
            "rm -rf Build"
        ]
    }
}
